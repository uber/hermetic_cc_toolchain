set -euo pipefail

indent() { sed 's/^/    /'; }

echo "--- Available toolchains:"
bazelisk query --noshow_progress 'kind(toolchain, @zig_sdk//toolchain/...)' | indent
echo "--- Available platforms:"
bazelisk query --noshow_progress 'kind(platform, @zig_sdk//platform/...)' | indent
echo "--- Available libc aware toolchains:"
bazelisk query --noshow_progress 'kind(toolchain, @zig_sdk//libc_aware/toolchain/...)' | indent
echo "--- Available libc aware platforms:"
bazelisk query --noshow_progress 'kind(platform, @zig_sdk//libc_aware/platform/...)' | indent
echo "--- Available libc variants:"
bazelisk query --noshow_progress 'attr(constraint_setting, zig_sdk//libc:variant, @zig_sdk//...)' | indent
