set -xeuo pipefail

example=$1

echo --- setup "$example"
root=$(git rev-parse --show-toplevel)
cd "examples/$example"

echo --- "testing examples/$example with toolchains_zig_cc pointing to git repository root"
# lockfile_mode=off, so examples/$example/MODULE.bazel.lock does not get the override below
bazelisk test --lockfile_mode=off "--override_module=toolchains_zig_cc=$root" --test_output=errors ...

echo --- "testing examples/$example with toolchains_zig_cc pointing to a directory produced by release tarball"
# generate release tarball and put to temp
REL=$(mktemp -d); trap 'rm -fr $REL' EXIT; "$root/ci/release_v99"
tar -vxf "../../toolchains_zig_cc-v99.0.0.tar.gz" -C "$REL"

# lockfile_mode=off, so examples/$example/MODULE.bazel.lock does not get the override below
bazelisk test --lockfile_mode=off "--override_module=toolchains_zig_cc=$REL" --test_output=errors ...

echo --- "testing examples/$example as is"
bazelisk test --test_output=errors ...
