load("@toolchains_zig_cc//toolchain:defs.bzl", "declare_files")
load("@toolchains_zig_cc//toolchain/private:cc_toolchains.bzl", "declare_cc_toolchains")
load("@toolchains_zig_cc//toolchain/private:zig_toolchain.bzl", "declare_zig_toolchain")

package(
    default_visibility = ["//visibility:public"],
)

declare_files(
    os = {os},
)

declare_cc_toolchains(
    os = {os},
    zig_sdk_path = {zig_sdk_path},
)

declare_zig_toolchain(name = "zig_toolchain")

alias(
    name = "exec_os",
    actual = "@platforms//os:{exec_os}",
)

alias(
    name = "exec_cpu",
    actual = "@platforms//cpu:{exec_cpu}",
)
