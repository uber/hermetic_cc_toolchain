#!/usr/bin/env bash

# Sets the module version, writes toolchains_zig_cc-<tag>.tar.gz, then
# commits and tags.

set -euo pipefail

usage()
(
    echo "Usage: release {tag}"
)

if [ "${1:0:1}" != "v" ]; then
    echo 'Release version must be prefixed with a "v"'
    usage && exit 1;
fi

tag=$1
tarball=toolchains_zig_cc-$tag.tar.gz

cd "$(git rev-parse --show-toplevel)"

sed -i -e "3s/\".*\"/\"${tag#v}\"/" MODULE.bazel
git add MODULE.bazel

git archive --format=tar.gz --mtime=2000-01-01T00:00:00Z -o "$tarball" \
    "$(git write-tree)" LICENSE MODULE.bazel toolchain
sha256=$( (sha256sum "$tarball" 2>/dev/null || shasum -a 256 "$tarball") | cut -d' ' -f1)

git commit -q -m "Release toolchains_zig_cc $tag"
git tag "$tag"
echo "wrote $tarball, sha256: $sha256"
